{
  "name": "ide-program",
  "private": true,
  "version": "0.4.0",
  "description": "A small demonstration of a PhreshOS Program that writes, builds, and runs another Program.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "vite-node scripts/build.ts",
    "start": "phresh start",
    "pack": "phresh pack",
    "verify": "node --run check && node --run build"
  },
